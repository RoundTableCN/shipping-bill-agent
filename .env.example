# AI API: first-run helper (recommended)
#   python scripts/configure_ai.py --show
#   python scripts/configure_ai.py --use-platform
#   python scripts/configure_ai.py --no-ai
#   python scripts/configure_ai.py --provider openai --model ... --base-url ... --api-key ...
# The saved config lives in ~/.shipping_agent/ai_config.json (override with
# AI_CONFIG_PATH).  Environment variables / .env remain supported.

# LLM (DeepSeek example)
# Copy this file to .env and fill in OPENAI_API_KEY.
LLM_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_STRUCTURED_METHOD=function_calling
# LLM_PROVIDER=deepseek          # deepseek | openai | anthropic
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MAX_TOKENS=4096
# LLM_DISABLE_THINKING=0         # set 1 for proxies that enable thinking by default
# LLM_TEMPERATURE=0

# DeepSeek-specific aliases are also accepted if you prefer:
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# Other OpenAI-compatible providers:
#   OpenAI:  https://api.openai.com/v1        model: gpt-4o-mini / gpt-4.1
#   Qwen:    https://dashscope.aliyuncs.com/compatible-mode/v1
#   Local:   http://localhost:8000/v1

# OCR (P1+)
OCR_ENDPOINT=https://gateway.pltplt.com/ai/process
OCR_TASK=orderChange
OCR_TASK_TYPE=
OCR_MODE=mock
# Public base URL that the OCR server can reach.
# Leave empty to force mock mode.
# Note: a document supplied as a public http(s) URL is sent to the OCR API
# directly, so OCR_FILE_BASE_URL is not required for that input path.
# Per-URL OCR deadline before local/vision fallback (seconds).
URL_OCR_TIMEOUT=60
OCR_FILE_BASE_URL=
# Local directory copied into the hosted directory (served by a tunnel/HTTP server).
OCR_SERVE_DIR=out/ocr_serve
# Legacy .doc: LibreOffice is preferred; without it, the built-in OLE parser
# is used. Set DOC_WORD_COM=1 to opt into Microsoft Word automation.
# DOC_WORD_COM=0

# The OCR task accepts PDF but times out on direct PNG; wrap images first.
OCR_IMAGE_AS_PDF=1
# In api mode, try OCR first for PDF pages; if OCR returns empty, fall back
# to the local text layer. Set to 0 to use local text first.
OCR_PDF_FIRST=1
# If mock/local/api all return no image content, use the vision LLM as the
# final recognizer. Results are forced to PENDING_REVIEW. Set 0 to disable.
# It reuses the first-run API when no explicit VISION_* values are set;
# both Anthropic (/v1/messages) and OpenAI-compatible (/chat/completions)
# endpoints are supported.
VISION_FALLBACK=1
# VISION_BASE_URL=https://api.deepseek.com/anthropic
# VISION_MODEL=deepseek-flash[1M]
# VISION_API_KEY=
# VISION_PROTOCOL=anthropic       # anthropic | openai (inferred if omitted)

# Output
OUTPUT_MODE=full
